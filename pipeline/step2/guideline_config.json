{
  "_comment": "Guideline-specific configuration. All domain knowledge lives here, not in Python code. To adapt the pipeline for a different guideline, create a new config file.",

  "disease": {
    "disease_id": "HeartFailure",
    "disease_name": "Heart Failure",
    "abbreviations": ["HF", "CHF"],
    "phenotype_prefix_regex": "\\b(HF\\w+)\\b"
  },

  "stage_scheme": "AHA/ACC",

  "guideline_organizations": [
    "AHA", "ACC", "ESC", "HFSA", "NICE", "CCS",
    "American Heart Association", "American College of Cardiology"
  ],

  "title_regex": "(\\d{4}\\s+(?:{orgs})[^\\n]{{20,}}(?:guideline|recommendation)[^\\n]*)",
  "source_regex": "((?:{orgs})[^.]{{5,80}})",

  "therapy_patterns": {
    "ACE inhibitors (ACEi)": "\\bace[- ]?inhibitor\\w*|\\bacei\\b",
    "Angiotensin Receptor Blockers (ARB)": "\\bangiotensin receptor blocker\\w*|\\barbs?\\b(?!itrary)",
    "Angiotensin Receptor-Neprilysin Inhibitors (ARNi)": "\\barni\\b|\\bsacubitril[- ]valsartan\\b",
    "Beta Blockers": "\\bbeta[- ]?blocker\\w*",
    "Mineralocorticoid Receptor Antagonists (MRA)": "\\bmineralocorticoid receptor antagonist\\w*|\\bmra\\b",
    "SGLT2 Inhibitors": "\\bsglt2[- ]?i\\w*|\\bsodium[- ]glucose co[- ]?transporter[- ]2\\w*",
    "Hydralazine and Isosorbide Dinitrate": "\\bhydralazine\\b.*\\bisosorbide\\b",
    "Ivabradine": "\\bivabradine\\b",
    "Digoxin": "\\bdigoxin\\b",
    "Vericiguat": "\\bvericiguat\\b",
    "Diuretics": "\\bdiuretic\\w*",
    "Cardiac Resynchronization Therapy (CRT)": "\\bcardiac resynchronization therap\\w*|\\bcrt\\b",
    "Implantable Cardioverter-Defibrillator (ICD)": "\\bimplantable cardioverter[- ]defibrillator\\w*|\\bicd\\b(?!-10)",
    "Cardiac Transplantation": "\\bcardiac transplant\\w*|\\bheart transplant\\w*",
    "Mechanical Circulatory Support (MCS)": "\\bmechanical circulatory support\\w*|\\blvad\\b",
    "Cardiac Rehabilitation": "\\bcardiac rehabilitation\\b",
    "Exercise Training": "\\bexercise training\\b|\\bexercise prescription\\b",
    "Sodium Restriction": "\\bsodium restriction\\b|\\bdietary sodium\\b",
    "Inotropic Therapy": "\\binotropic therap\\w*|\\binotrope\\w*",
    "Omega-3 PUFA": "\\bomega[- ]?3\\b.*\\bpufa\\b",
    "Anticoagulation Therapy": "\\banticoagulat\\w+\\s+therap\\w*"
  },

  "therapy_type_keywords": {
    "device": ["icd", "crt", "pacemaker", "lvad", "mechanical circulatory", "implantable"],
    "procedural": ["transplant", "revascularization", "surgery", "ablation"],
    "lifestyle": ["exercise", "rehabilitation", "sodium restriction", "self-care", "diet"],
    "_default": "pharmacological"
  },

  "assessment_categories": {
    "echocardiography": "echocardiograph\\w*|transthoracic echocardiogram|transesophageal echocardiogram|tte\\b|tee\\b",
    "electrocardiogram": "electrocardiogra\\w*|\\becg\\b|\\bekg\\b|12[- ]lead",
    "natriuretic_peptide": "b[- ]?type natriuretic peptide|\\bbnp\\b|nt[- ]?probnp|natriuretic peptide",
    "troponin": "troponin\\w*|cardiac troponin|hs[- ]?troponin",
    "cardiac_imaging": "cardiovascular magnetic resonance|cardiac mr[i]?\\b|magnetic resonance|cardiac ct|coronary ct|nuclear imaging|radionuclide|pet scan|spect",
    "hemodynamic": "hemodynamic measure\\w*|invasive hemodynamic|right heart catheteriz\\w*|swan[- ]ganz|pulmonary artery catheter",
    "stress_testing": "exercise stress test\\w*|stress test\\w*|cardiopulmonary exercise|cpet|exercise capacity|6[- ]?minute walk|6mw[td]",
    "laboratory": "laboratory test\\w*|serum creatinine|blood urea nitrogen|\\bbun\\b|electrolyte|complete blood count|\\bcbc\\b|liver function|thyroid function|iron studies|ferritin|hemoglobin a1c",
    "biomarker": "biomarker\\w*|galectin[- ]?3|st2|soluble st2|mid[- ]?regional",
    "genetic": "genetic evaluat\\w*|genetic test\\w*|genetic counsel\\w*|cardiomyopathy gene|next[- ]generation sequencing|exome",
    "biopsy": "endomyocardial biopsy|myocardial biopsy|tissue biopsy",
    "doppler": "doppler\\w*|tissue doppler|pulsed[- ]wave doppler",
    "remote_monitoring": "remote monitor\\w*|telemonitor\\w*|device monitor\\w*|wearable\\w*|implantable monitor",
    "physical_exam": "physical exam\\w*|jugular venous|auscultation|palpation|peripheral edema|lung exam"
  },

